{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "node -e \"require('fs').mkdirSync('test-results',{recursive:true})\" && eslint .",
    "test:smoke": "playwright test",
    "test:integration": "tsx --test tests/integration/**/*.test.ts",
    "quality:release": "npm run lint && npx tsc --noEmit && npm run build && npm run test:integration && npm run db:audit-integrity && npm run test:smoke && npm audit --omit=dev && npx prisma validate && npx prisma migrate status",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:audit-integrity": "tsx scripts/db/audit-integrity.ts",
    "db:repair-integrity": "tsx scripts/db/repair-integrity.ts",
    "ops:secret-manager-check": "tsx scripts/ops/secret-manager-check.ts",
    "ops:backup-restore-drill": "tsx scripts/ops/backup-restore-drill.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.940.0",
    "@aws-sdk/client-secrets-manager": "^3.940.0",
    "@prisma/client": "^6.16.3",
    "jose": "^6.1.3",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "redis": "^5.11.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^6.16.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
